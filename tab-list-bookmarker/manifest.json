{
  "manifest_version": 3,
  "name": "Sidebar Tab Manager",
  "version": "1.1",
  "description": "Lists tabs, allows closing, bookmarking, grouping, and stashing.",
  "permissions": [
    "tabs",
    "bookmarks",
    "sidePanel",
    "favicon",
    "tabGroups",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Tab Manager Sidebar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "128": "icons/icon128.png"
  }
}
