{
  "manifest_version": 3,
  "name": "Sidebar Tab Manager",
  "version": "1.0",
  "description": "Lists tabs in the sidebar, allows closing and bookmarking selected tabs.",
  "permissions": ["tabs", "bookmarks", "sidePanel", "favicon"],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Tab Manager Sidebar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
