{
  "manifest_version": 3,
  "name": "Sidebar Tab Manager",
  "version": "1.3",
  "description": "Lists tabs, allows closing, bookmarking, grouping, stashing, and highlighting stashed links. Now with YouTube stashing!",
  "permissions": [
    "tabs",
    "bookmarks",
    "sidePanel",
    "favicon",
    "tabGroups",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tab Manager Sidebar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.youtube.com/*"],
      "js": ["content_script.js"],
      "css": ["highlight.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_script_youtube.js"],
      "css": ["highlight.css", "youtube_button_styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "highlight.css",
        "youtube_button_styles.css",
        "icons/stash_icon.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
